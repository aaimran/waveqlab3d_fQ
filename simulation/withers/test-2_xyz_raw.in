! waveqlab3d input file: Withers constant-Q benchmark (gamma=0)

&problem_list
 name = 'test-2_xyz_raw',
 problem = 'TPV5',
 nblocks = 2,
 t_final =  06.0d0,
 CFL = 0.34640762d0,
 coupling='locked',
 type_of_mesh='cartesian',
 material_source='hardcode',
 fd_type = 'traditional',
 order = 6,
 response = 'viscoelastic',
 w_stride = 1,
 w_fault = F /

&block_list
btp(1)%nqrs =   101,   51,  201,
btp(1)%aqrs =  -5d0,  0d0, -5d0,
btp(1)%bqrs =   5d0,  5d0, 15d0,
btp(1)%rho_s_p = 2.7d0, 3.464d0, 6d0,
btp(1)%lqrs = 1, 2, 1,
btp(1)%rqrs = 0, 1, 1,
btp(1)%pml_lqrs = T, F, T,
btp(1)%pml_rqrs = F, T, T,
btp(1)%npml = 21,

btp(2)%nqrs =  101,   51,  201,
btp(2)%aqrs =  5d0,  0d0, -5d0,
btp(2)%bqrs = 15d0,  5d0, 15d0,
btp(2)%rho_s_p = 2.7d0, 3.464d0, 6d0,
btp(2)%lqrs = 0, 2, 1,
btp(2)%rqrs = 1, 1, 1,
btp(2)%pml_lqrs = F, F, T,
btp(2)%pml_rqrs = T, T, T,
btp(2)%npml = 21/

&viscoelastic_list
 attenuation = 'frequency-Q',
 Qs0 = 50d0, 50d0,
 Qp0 = 100d0, 100d0,
 gamma = 0.0d0,
 fmin = 0.05d0,
 fmax = 20.0d0,
 fref = 1.0d0,
 f_transition = 1.0d0,
 n_mechanisms = 8,
 weight_method = 'withers-table',
 max_fit_error = 0.10d0 /

&moment_list
 use_moment_tensor = T,
 order = 4 /

!---begin:tensor_list---
'Cos-Bell' 0d0 0.2d0 0d0 0d0 0d0 0d0 -10d0 0d0 0d0 1.8d0 0d0 0
!---end:tensor_list---

&mms_list
 use_mms = F /

&output_list
 output_exact_moment = F,
 output_fault_topo = F,
 output_fields_block1 = F,
 output_fields_block2 = F,
 stride_fields = 1,
/

&output_receiver_stations
 output_seismograms = T,
 output_station_info = F,
 output_station_mapping = F,
 station_xyz_index = F,
 station_list = 'infile',
 station_list_file = '',
 station_file_directory = '',
 station_output_order = 't vx vy vz',
 station_number_in_list = T,
 station_number_in_filename = T,
 station_use_block_subdirectories = F,
 append_block = F,
 interface_stations='block_1',
 station_add_header = T,
 station_add_metadata = T,
 /



